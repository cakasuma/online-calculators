# AdSense (client / Vite, build-time)
VITE_ADSENSE_CLIENT=ca-pub-1234567890123456
VITE_ADSENSE_SLOT_TOP=1234567890
VITE_ADSENSE_SLOT_HOME=0987654321

# Plausible analytics (client / Vite, build-time)
# Set to your verified domain. Leave blank to disable.
VITE_PLAUSIBLE_DOMAIN=hellokalku.com
# Optional self-hosted Plausible endpoint
# VITE_PLAUSIBLE_SCRIPT=https://plausible.io/js/script.js

# Lead capture / events DB (server, runtime). Postgres URL.
# When unset, leads/events are stored in memory only and lost on restart.
# DATABASE_URL=postgres://user:pass@host:5432/db
