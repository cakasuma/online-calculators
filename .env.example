# AdSense (client / Vite, build-time)
VITE_ADSENSE_CLIENT=ca-pub-1234567890123456
VITE_ADSENSE_SLOT_TOP=1234567890
VITE_ADSENSE_SLOT_HOME=0987654321

# Lead capture / events DB (server, runtime). Postgres URL.
# When unset, leads/events are stored in memory only and lost on restart.
#
# For Supabase: copy the "Transaction pooler" connection string (port 6543)
# from Project Settings → Database → Connection string, and replace
# [YOUR-PASSWORD] with your DB password.
# For migrations (drizzle-kit push), use the "Direct connection" URL
# (port 5432) instead, in a separate one-shot command.
# DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
