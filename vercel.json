{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.hellokalku.com" }],
      "destination": "https://hellokalku.com/:path*",
      "permanent": true
    },
    { "source": "/", "destination": "/en", "permanent": true },
    { "source": "/salary", "destination": "/en/salary", "permanent": true },
    { "source": "/normal", "destination": "/en/normal", "permanent": true },
    { "source": "/scientific", "destination": "/en/scientific", "permanent": true },
    { "source": "/faraid", "destination": "/en/faraid", "permanent": true },
    { "source": "/zakat", "destination": "/en/zakat", "permanent": true },
    { "source": "/wasiat", "destination": "/en/wasiat", "permanent": true },
    { "source": "/privacy", "destination": "/en/privacy", "permanent": true },
    { "source": "/terms", "destination": "/en/terms", "permanent": true },
    { "source": "/about", "destination": "/en/about", "permanent": true },
    { "source": "/contact", "destination": "/en/contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/((?!404$)(?!.*\\.).*)", "destination": "/404" }
  ],
  "headers": [
    {
      "source": "/:locale(en|ms|id)/currency-converter/:pair",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "ALLOWALL" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors *;" }
      ]
    },
    {
      "source": "/embed.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    }
  ]
}
